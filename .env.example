# 中层绩效考核系统 - 环境变量示例
# 复制为 .env 或通过 export 注入到 systemd / 容器环境

# 【必改】会话签名密钥：生产环境必须替换为强随机值
# 生成命令: python3 -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-me-to-a-long-random-string

# 服务监听端口（需与 gunicorn.conf.py、nginx.conf、防火墙一致）
PORT=8000

# gunicorn Worker 数量（2核2G 服务器填 2 即可）
GUNICORN_WORKERS=2
