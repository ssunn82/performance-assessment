# 中层绩效考核系统 - 环境变量示例
# 复制为 .env 或通过 export 注入到 systemd / 容器环境

# 【必改】会话签名密钥：生产环境必须替换为强随机值
# 生成命令: python3 -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-me-to-a-long-random-string

# 服务监听端口（需与 gunicorn.conf.py、nginx.conf、防火墙一致）
PORT=8000

# gunicorn Worker 数量（2核2G 服务器填 2 即可）
GUNICORN_WORKERS=2

# 绑定的地址（默认仅本机，公网不可直连；不用 nginx 时才改 0.0.0.0）
BIND=127.0.0.1

# 外部访问地址：决定二维码/Excel 里的扫码链接前缀。
# 强烈建议显式设置为你的域名，否则生成的链接会带内网 IP 或端口，
# 扫码方在外网将无法访问。
#   配了域名 + HTTPS 反代时，务必填 https://kaohe.你的域名.com（不带末尾斜杠）
#   未配域名时填 http://<公网IP>:8851
BASE_URL=https://kaohe.你的域名.com
