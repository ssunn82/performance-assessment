# 统一换行符策略
# shell 脚本必须用 LF，否则在 Linux 服务器上执行会因 ^M 报错
*.sh text eol=lf

# Python 源码在仓库内统一存 LF，工作区由各平台自行处理
*.py text eol=lf

# 前端与文档
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf

# 二进制文件不做换行转换
*.db binary
*.db-wal binary
*.db-shm binary
*.png binary
*.jpg binary
*.xlsx binary
*.zip binary